# shellcheck shell=bash
# Configuration du socle (versionnée). Pour une valeur propre à une machine (autre plage d'adresses, autre disque),
# créer infra/config.local.env (non versionné) avec seulement les lignes à changer. Exemple :
#   S7_SUBNET=192.168.150
#   S7_IMAGES_DIR=/mnt/nvme/s7-images

# Dépôt GitHub (runner, secrets, workflows)
S7_GITHUB_REPO="${S7_GITHUB_REPO:-Polk4a/DevOps-Sujet7}"

# Réseau libvirt NAT du projet (architecture, section 4.3). Les 3 premiers octets seulement.
S7_SUBNET="${S7_SUBNET:-192.168.100}"
S7_NET_NAME="${S7_NET_NAME:-s7-net}"
S7_BRIDGE="${S7_BRIDGE:-virbr-s7}"
# MTU des cartes des VM. Vide = 1500. À baisser (ex. 1400) si les téléchargements TLS se bloquent (R13).
S7_MTU="${S7_MTU:-}"

# Disques des VM et image de base (doit pouvoir être lu par libvirt-qemu)
S7_IMAGES_DIR="${S7_IMAGES_DIR:-/var/lib/libvirt/images/s7}"

# Dimensionnement : profil réduit (machine de moins de 16 Go, inventaire du 05/11)
S7_FORGE_VCPU="${S7_FORGE_VCPU:-2}"; S7_FORGE_RAM="${S7_FORGE_RAM:-4096}"; S7_FORGE_DISK="${S7_FORGE_DISK:-60}"
S7_CP_VCPU="${S7_CP_VCPU:-2}";       S7_CP_RAM="${S7_CP_RAM:-3072}";       S7_CP_DISK="${S7_CP_DISK:-30}"
S7_W1_VCPU="${S7_W1_VCPU:-2}";       S7_W1_RAM="${S7_W1_RAM:-3072}";       S7_W1_DISK="${S7_W1_DISK:-30}"
S7_WITH_W2="${S7_WITH_W2:-0}"        # 1 pour ajouter s7-w2 (machine de 16 Go ou plus)

# Fuseau horaire des VM (chrony synchronise l'heure : certificats et signatures en dépendent)
S7_TIMEZONE="${S7_TIMEZONE:-Europe/Paris}"
